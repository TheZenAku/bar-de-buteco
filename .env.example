NODE_ENV=development
API_PORT=3001
GAME_PORT=2567
WEB_ORIGIN=http://localhost:5173
# Activate accounts immediately; defaults to true locally and false in production.
AUTO_VERIFY_EMAIL=true
# Configure the same random secret (at least 32 characters) in API and server in production.
AUTH_SECRET=local-development-only-change-before-deploying
# Empty uses persistent embedded PostgreSQL (.data/postgres); set for native PostgreSQL.
DATABASE_URL=
ROOM_CAPACITY=32
EVENT_MIN_MS=300000
EVENT_MAX_MS=600000
BLACKJACK_TURN_MS=25000
SMTP_HOST=
SMTP_PORT=1025
MAIL_FROM=B.A.R. <bar@localhost>
