NODE_ENV=development
API_PORT=3001
GAME_PORT=2567
# Mundos (bares) em processos separados atrás da porta acima (1 = como sempre). Cada mundo comporta ROOM_CAPACITY pessoas (até 1024), no GAME_PORT+1+n.
# Pessoas em mundos diferentes não se veem. Ex.: WORLD_SHARDS=1 e ROOM_CAPACITY=1024 (um bar só, todo mundo se vê) ou WORLD_SHARDS=8 e ROOM_CAPACITY=128.
WORLD_SHARDS=1
WEB_ORIGIN=http://localhost:5173
# Activate accounts immediately; defaults to true locally and false in production.
AUTO_VERIFY_EMAIL=true
# Tickets only. Generate a random secret with at least 32 characters.
AUTH_SECRET=local-development-only-change-before-deploying
# API/world internal calls, metrics and log pseudonyms. Production requires a different random secret.
# When omitted, development temporarily falls back to AUTH_SECRET for migration compatibility.
INTERNAL_SECRET=
# Empty uses persistent embedded PostgreSQL (.data/postgres); set for native PostgreSQL.
DATABASE_URL=
# The explicit migration runner falls back to DATABASE_URL outside production. Set these when
# testing PostgreSQL's split roles locally; never give the runtime URL DDL permissions.
MIGRATION_DATABASE_URL=
MIGRATION_ROLE=
MIGRATION_RUNTIME_ROLE=
MIGRATION_LOCK_TIMEOUT_MS=30000
ROOM_CAPACITY=32
EVENT_MIN_MS=2700000
EVENT_MAX_MS=5400000
BLACKJACK_TURN_MS=25000
SMTP_HOST=
SMTP_PORT=1025
MAIL_FROM=B.A.R. <bar@localhost>
# Wallet and skin shop: initial/daily coins stay disabled until the game's economy is defined. Nathan is free.
WALLET_INITIAL_COINS=0
WALLET_DAILY_COINS=0
SKIN_PRICE_LEANDRO=750
SKIN_PRICE_RAFAEL=1000
SKIN_PRICE_READ=850
SKIN_PRICE_GILMAR_GORDO=900
SKIN_PRICE_GABRIEL=900
SKIN_PRICE_FLAVIO_HIPOTETICO=900
