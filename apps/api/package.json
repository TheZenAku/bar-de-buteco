{
  "name": "@bar/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run migrate",
    "dev": "tsx watch --include \"../../packages/shared/src/**/*.{ts,json}\" src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:postgres": "tsx --test test/postgres-smoke.test.ts",
    "preseed": "npm run migrate",
    "seed": "tsx src/seed.ts",
    "admin": "tsx src/admin.ts",
    "migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@bar/shared": "*",
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
