{
  "name": "bar-de-buteco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.20.0 <12",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n API,MUNDO,WEB -c cyan,yellow,green \"npm run dev -w @bar/api\" \"npm run dev -w @bar/server\" \"npm run dev -w @bar/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "build": "npm run typecheck && npm run build -w @bar/web",
    "test": "npm run test -w @bar/api && npm run test -w @bar/server && tsx --test tests/integration/*.test.ts && node --test tests/tools/*.test.mjs",
    "test:e2e": "playwright test",
    "test:load": "tsx --tsconfig tsconfig.base.json tests/load/room.ts",
    "bots": "tsx --tsconfig tsconfig.base.json tests/load/bots.ts",
    "assets:animations": "node tools/assets/convert-animations.mjs",
    "assets:retarget": "node tools/assets/retarget-skins.mjs && node tools/assets/convert-animations.mjs",
    "assets:skins": "node tools/assets/import-mixamo.mjs && node tools/assets/convert-animations.mjs",
    "assets:map": "node tools/assets/repair-map-cart.mjs && node tools/assets/import-map.mjs",
    "assets:repair-cart": "node tools/assets/repair-map-cart.mjs",
    "assets:drinks": "node tools/assets/import-drinks.mjs",
    "assets:moto": "node tools/assets/import-moto.mjs",
    "assets:ambient": "node tools/assets/import-ambient.mjs",
    "assets:icons": "node tools/assets/import-icons.mjs",
    "ops:backup": "node tools/ops/postgres-backup.mjs",
    "ops:restore-check": "node tools/ops/postgres-restore-check.mjs",
    "assets:mixamo-export": "node tools/assets/export-mixamo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "meshoptimizer": "1.3.0",
    "three": "0.180.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "argon2": false,
    "esbuild": false,
    "msgpackr-extract": false
  }
}
