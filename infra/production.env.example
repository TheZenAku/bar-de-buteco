# Copy outside version control and pass --env-file explicitly.
# Generate independent secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=replace_with_random_hex_password
AUTH_SECRET=replace_with_an_independent_random_secret_at_least_32_characters
WEB_ORIGIN=https://bar.example.com
AUTO_VERIFY_EMAIL=false
WEB_PORT=8080
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=B.A.R. <bar@example.com>
ROOM_CAPACITY=32
EVENT_MIN_MS=300000
EVENT_MAX_MS=600000
BLACKJACK_TURN_MS=25000
